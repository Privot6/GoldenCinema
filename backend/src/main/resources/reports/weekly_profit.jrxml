<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="weekly_profit"
              pageWidth="595"
              pageHeight="842"
              columnWidth="515"
              leftMargin="40"
              rightMargin="40"
              topMargin="40"
              bottomMargin="40"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="REPORT_FROM" class="java.lang.String"/>
    <parameter name="REPORT_TO" class="java.lang.String"/>
    <parameter name="REPORT_TOTAL" class="java.math.BigDecimal"/>

    <field name="movieTitle" class="java.lang.String"/>
    <field name="screeningsCount" class="java.lang.Long"/>
    <field name="ticketsCount" class="java.lang.Long"/>
    <field name="revenue" class="java.math.BigDecimal"/>

    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="515" height="30"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Raport Zysku]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="515" height="20"/>
                <textElement textAlignment="Center">
                    <font fontName="DejaVu Sans" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA["Okres: " + $P{REPORT_FROM} + " — " + $P{REPORT_TO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="206" height="25" backcolor="#CCCCCC"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Film]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="206" y="0" width="77" height="25" backcolor="#CCCCCC"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Seanse]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="283" y="0" width="77" height="25" backcolor="#CCCCCC"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Bilety]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="360" y="0" width="155" height="25" backcolor="#CCCCCC"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true"/>
                </textElement>
                <text><![CDATA[Przychód]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="206" height="20"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{movieTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="206" y="0" width="77" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{screeningsCount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="283" y="0" width="77" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ticketsCount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="360" y="0" width="155" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{revenue}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="35">
            <line>
                <reportElement x="0" y="2" width="515" height="1"/>
            </line>
            <staticText>
                <reportElement x="0" y="5" width="360" height="25"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true" size="12"/>
                </textElement>
                <text><![CDATA[Łączny przychód:]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="360" y="5" width="155" height="25"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" isBold="true" size="12"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{REPORT_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
