## Copy this file to local.properties and set your BASE_URL.
## Do NOT commit local.properties — it is gitignored.

# Android Emulator (default — host machine is reachable at 10.0.2.2)
BASE_URL=http://10.0.2.2:8080/api/

# Physical device — use the IP of the machine running Docker
# BASE_URL=http://192.168.x.x:8080/api/
